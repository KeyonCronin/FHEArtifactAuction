{
  "name": "confidential-artifact-auction",
  "version": "1.0.0",
  "description": "Privacy-preserving auction platform for authentic artifacts using FHE encryption",
  "main": "index.html",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:coverage": "hardhat coverage",
    "coverage": "hardhat coverage",
    "deploy": "hardhat run scripts/deploy.js",
    "deploy:sepolia": "hardhat run scripts/deploy.js --network sepolia",
    "verify": "hardhat run scripts/verify.js --network sepolia",
    "interact": "hardhat run scripts/interact.js --network sepolia",
    "simulate": "hardhat run scripts/simulate.js --network localhost",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "lint": "npm run lint:sol && npm run lint:js",
    "lint:sol": "solhint 'contracts/**/*.sol'",
    "lint:sol:fix": "solhint 'contracts/**/*.sol' --fix",
    "lint:js": "eslint '**/*.js' --ignore-pattern node_modules/",
    "lint:js:fix": "eslint '**/*.js' --ignore-pattern node_modules/ --fix",
    "format": "prettier --write '**/*.{js,json,sol,md}'",
    "prettier:check": "prettier --check '**/*.{js,json,sol,md}'",
    "prettier:fix": "prettier --write '**/*.{js,json,sol,md}'",
    "security:check": "npm audit && npm run lint:sol",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "gas:report": "REPORT_GAS=true npm test",
    "size:check": "hardhat size-contracts",
    "prepare": "node -e \"try { require('husky').install() } catch (e) { if (e.code !== 'MODULE_NOT_FOUND') throw e }\"",
    "precommit": "npm run lint && npm run prettier:check",
    "prepush": "npm test",
    "dev": "npx http-server . -p 3000 -c-1 --cors",
    "start": "npx http-server . -p 8080 -c-1 --cors"
  },
  "keywords": [
    "blockchain",
    "auction",
    "ethereum",
    "fhe",
    "artifacts",
    "confidential",
    "hardhat",
    "smart-contracts",
    "security",
    "gas-optimization"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fhevm/solidity": "^0.5.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "chai": "^4.3.10",
    "eslint": "^8.57.0",
    "hardhat": "^2.22.0",
    "hardhat-contract-sizer": "^2.10.0",
    "hardhat-gas-reporter": "^2.0.0",
    "husky": "^9.0.0",
    "prettier": "^3.2.0",
    "prettier-plugin-solidity": "^1.3.0",
    "solhint": "^4.5.0",
    "solidity-coverage": "^0.8.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
